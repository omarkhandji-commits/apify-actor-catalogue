            "required": true
          },
          {
            "name": "actorId",
            "type": "select",
            "label": "Actor",
            "required": true
          },
          {
            "name": "inputBodyrgWQ2fNhyhhekWpCa",
            "type": "text",
            "label": "Input JSON",
            "required": true
          },
          {
