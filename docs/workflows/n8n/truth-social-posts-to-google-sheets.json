        "jsonBody": "{\n  \"accounts\": [\n    \"realDonaldTrump\"\n  ],\n  \"maxPostsPerAccount\": 60,\n  \"onlyNewPosts\": true,\n  \"maxTotalChargeUsd\": 0.5\n}",
