        "jsonBody": "{\n  \"routes\": [\n    \"Paris, FR -> Amsterdam\"\n  ],\n  \"numberOfDays\": 30,\n  \"directOnly\": true,\n  \"maxTotalChargeUsd\": 0.5\n}",
