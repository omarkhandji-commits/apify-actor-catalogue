        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"videoUrls\": [\n    \"https://www.youtube.com/watch?v=dQw4w9WgXcQ\"\n  ],\n  \"maxComments\": 200,\n  \"maxTotalChargeUsd\": 0.5\n}",
        "options": {
          "timeout": 300000
        }
      },
